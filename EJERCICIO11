#include <iostream>
using namespace std;
int main() {
    int mayor=0, menor=1000, A[5]={4, 8, 7, 9, 5}, i;
    for (i=0; i<5; i++) {
        if (A[i]<menor) {
            menor=A[i];
        }
        for(i=0; i<5; i++) {
            if(A[i]>mayor) {
                mayor=A[i];
            }
        }
    }
    cout<<mayor+menor<<endl;
    return 0;
}