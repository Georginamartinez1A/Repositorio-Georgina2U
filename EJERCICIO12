#include <iostream>
using namespace std;
int main() {
    int A[5]={10, 20, 30, 40, 50}, n=5, i, mayor, menor, suma;
    mayor = 0;
    menor = 0;
    for (i=0; i<n; i++) {
        if (A[i]>mayor) {
            mayor=A[i];
        }
        if (A[i]<menor) {
            menor=A[i];
        }
    }
    suma=mayor + menor;
    cout<<suma;
    return 0;
}