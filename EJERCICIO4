#include <iostream>
using namespace std;
int main () {
    int n=5, i, k=0, j;
    int A[n]={0, 1, 2, 3, 4};
    for (i=0; i<n; i++) {
        for (j=0; j<=3; j++) {
            A[k]=i;
            k=k+1;
        }
    }
    for (i=0; i<n;i++) {
        cout<<A[i]<<endl;
    }
    return 0;
}