#include <iostream>
using namespace std;

    int A={1, 2, 3, 4, 5};
    int Suma(int array[], int n) {
        Suma=0;
        for (i=0; i<n; i++){
            Suma=Suma+array[i];
        return Suma;        }
    }
    void imprime(int array[], int n) {
        for(i=0; i<=n; i++) {
            cout<<array[i]<<" ";
        }
    }
    int main() {
        const n=5;
        int array[5]={1, 2, 3, 4, 5};
        imprime(array, n);
        cout<<"La suma es: "<<Suma(array, n)<<endl;
        return 0;
    }